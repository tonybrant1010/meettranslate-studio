# Másold le ezt a fájlt ".env" néven, és írd be a saját kulcsodat.
# Kulcs: https://aistudio.google.com/apikey
GEMINI_API_KEY=ide_masold_a_kulcsot

# Opcionális: a fordító modell neve (alapértelmezett: gemini-3.5-live-translate-preview)
# GEMINI_MODEL=gemini-3.5-live-translate-preview

# Opcionális: port (alapértelmezett: 8000)
# PORT=8000
